# Hardhat local deployment config
RPC_URL=http://hardhat:8545
# 64 hex bytes with 0x prefix; if left empty, Hardhat will use its default mnemonic accounts
# Example first default Hardhat account: 0x59c6995e998f97a5a0044966f09453867ee361b9758d6a4f2d1de74d5e5c2d8e
PRIVATE_KEY=
NFT_CHAIN_ID=31337
BASE_URI= # optional; leave empty to inline tokenURI JSON with cardDefinitionId
# Loot pool: comma list or path to JSON array (matching prisma seed card ids)
LOOT_POOL=/workspace/hardhat/loot-pool.json
